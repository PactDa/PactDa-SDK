{
  "name": "@pactda/sdk-lite",
  "version": "0.0.1",
  "description": "PactDa SDK - Simple TypeScript SDK for trust-based agreements without blockchain complexity",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run test:ci",
    "publish:npm": "npm publish --access public"
  },
  "keywords": [
    "pactda",
    "trust",
    "escrow",
    "agreements",
    "blockchain",
    "sui",
    "sdk",
    "typescript",
    "web3",
    "gaming"
  ],
  "author": "PactDa Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pactda/pactda-sdk.git",
    "directory": "sdk"
  },
  "homepage": "https://pactda.com",
  "bugs": {
    "url": "https://github.com/pactda/pactda-sdk/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "dependencies": {
    "@mysten/enoki": "^0.3.0",
    "axios": "^1.6.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jsdom": "^26.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.1.0"
  }
}
