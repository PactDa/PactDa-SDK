# =============================================================================
# PactDa Server - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and update with your values
# Used by docker-compose.yml for container configuration
# =============================================================================

# =============================================================================
# POSTGRES DATABASE (for docker-compose services)
# =============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=11223344
POSTGRES_DB=Pactda_DB

# =============================================================================
# PGADMIN (for docker-compose pgadmin service)
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@pactda.com
PGADMIN_DEFAULT_PASSWORD=11223344

# =============================================================================
# APPLICATION CONFIGURATION (for nestjs service)
# =============================================================================
NODE_ENV=development
PORT=3000

# Database Connection (matches postgres service)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=11223344
DB_NAME=Pactda_DB

# JWT Configuration (REQUIRED - generate secure secret)
JWT_SECRET=your-super-secure-jwt-secret-key-32-characters-minimum
JWT_EXPIRATION=24h

# Application Domain
DOMAIN=http://localhost:3000

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Google OAuth (leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Mail Service (for development, you can use mailhog or leave empty)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=

# Security Settings (development-friendly defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
EXTERNAL_API_TIMEOUT_MS=10000

# =============================================================================
# QUICK SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Update JWT_SECRET in .env file
# 4. Run: docker-compose up -d --build
# 5. Access:
#    - API: http://localhost:3000
#    - PgAdmin: http://localhost:8080 (admin@pactda.com / 11223344)
#    - Database: localhost:5432 (admin / 11223344 / Pactda_DB)

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# For production deployment:
# - Change all default passwords
# - Use secure JWT_SECRET (32+ characters)
# - Set NODE_ENV=production
# - Configure proper DOMAIN with HTTPS
# - Set up proper mail service credentials
# - Adjust rate limiting for production load
# - Use environment-specific database credentials